---
import DefaultLayout from './DefaultLayout.astro';
import { SITE_TITLE } from '../config';

interface Props {
  title: string;
  date: Date;
  author?: string;
  tags?: string[];
  reading_time?: number;
  description?: string;
}

const { title, date, author, tags, reading_time, description } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<DefaultLayout title={title} description={description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Post Header -->
    <div class="mb-12 pb-12 border-b border-gray-200">
      <h1 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900">{title}</h1>

      <div class="flex flex-wrap gap-6 text-sm text-gray-600 mb-6">
        <span class="flex items-center gap-2">
          📅 {formattedDate}
        </span>
        {author && (
          <span class="flex items-center gap-2">
            ✍️ {author}
          </span>
        )}
        {reading_time && (
          <span class="flex items-center gap-2">
            ⏱️ {reading_time} min de lecture
          </span>
        )}
      </div>

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="inline-block bg-purple-100 text-purple-700 px-3 py-1 rounded-full text-sm font-medium hover:bg-purple-200 transition">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Post Content -->
    <div class="prose prose-lg max-w-none mb-12">
      <slot />
    </div>

    <!-- Back Link -->
    <div class="pt-8 border-t border-gray-200">
      <a href="/blog/" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-semibold transition">
        ← Retour au blog
      </a>
    </div>
  </article>
</DefaultLayout>
