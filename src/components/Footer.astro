---
import { SITE_TITLE, SITE_DESCRIPTION } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="bg-gradient-to-r from-blue-50 to-purple-50 border-t border-gray-200 mt-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="text-center">
      <p class="text-gray-700 font-semibold text-lg mb-2">{SITE_TITLE}</p>
      <p class="text-gray-600 text-sm mb-4">{SITE_DESCRIPTION}</p>
      <p class="text-gray-500 text-xs">&copy; {currentYear} {SITE_TITLE}. All rights reserved.</p>
    </div>
  </div>
</footer>
