---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
---

<DefaultLayout title="Activité 1">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-8">
      <a href="/activites/" class="text-blue-600 hover:text-blue-700 font-medium transition text-sm">← Retour aux activités</a>
    </div>

    <div class="bg-white rounded-lg shadow-md p-8 border border-gray-200">
      <h1 class="text-4xl font-bold text-gray-900 mb-6">Activité 1</h1>
      <p class="text-lg text-gray-600">Contenu de l'activité 1 à venir.</p>
    </div>

  </div>
</DefaultLayout>
