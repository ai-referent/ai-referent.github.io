---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
---

<DefaultLayout title="Conseil en stratégie IT augmentée par l'IA">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-8">
      <a href="/activites/" class="text-amber-700 hover:text-amber-800 font-medium transition text-sm">← Retour aux services</a>
    </div>

    <div class="mb-8">
      <div class="text-4xl mb-4">🚀</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">Conseil en stratégie IT augmentée par l'IA</h1>
      <p class="text-lg text-gray-400 italic bg-gray-50 border border-dashed border-gray-300 rounded-lg p-4 mb-6">
        [Texte introductif à rédiger]
      </p>
      <ul class="list-disc list-outside ml-5 space-y-2 text-gray-700 text-lg">
        <li>Définition d'une stratégie IA (use cases prioritaires, ROI)</li>
        <li>Intégration de l'IA dans la roadmap SI</li>
        <li>Arbitrage build vs buy (modèles internes vs solutions du marché)</li>
      </ul>
    </div>

  </div>
</DefaultLayout>
