---
import DefaultLayout from '../../layouts/DefaultLayout.astro';

const activitesTop = [
  {
    slug: 'conseil-transformation-ia',
    icon: '🔧',
    titre: "Conseil en transformation par l'IA",
    soustitre: '',
    description: "Une prestation à mi-chemin entre le cabinet de conseil (diagnostic, priorisation) et le studio tech, avec les futurs utilisateurs impliqués dès le build.",
  },
  {
    slug: 'conferences',
    icon: '🎤',
    titre: 'Conférences / Sessions de décryptage / Sensibilisation',
    soustitre: '',
    description: "Interventions en entreprise pour démystifier l'IA, ses enjeux et ses usages concrets.",
  },
  {
    slug: 'gouvernance',
    icon: '⚖️',
    titre: "Structurer votre gouvernance Data & IA",
    soustitre: '',
    description: "Mise en place des politiques, processus et structures de pilotage pour maîtriser vos données et vos usages IA dans la durée.",
  },
];

const activitesBottom = [
  {
    slug: 'acheter-ia',
    icon: '🛡️',
    titre: "Acheter l'IA sans se tromper",
    soustitre: "L'expert IA dans votre camp",
    description: "Quelques jours de travail pour éviter des mois de prestation mal achetée : cahier des charges, grille d'évaluation, sélection de prestataires.",
  },
  {
    slug: 'talent-advisory-it',
    icon: '🎯',
    titre: 'Talent advisory IT',
    soustitre: '',
    description: "Aide à la définition des profils, à l'évaluation technique et au choix des candidats pour les postes liés à l'IA.",
  },
  {
    slug: 'conseil-strategique-technique',
    icon: '🧭',
    titre: 'Conseil stratégique technique',
    soustitre: 'Session intensive demi-journée',
    description: "Une demi-journée pour comprendre où va vraiment l'IA : architectures émergentes, ruptures à venir, conséquences concrètes sur vos systèmes et vos choix.",
  },
];
---

<DefaultLayout title="Services">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-10">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Services</h1>
      <p class="text-xl text-gray-700 leading-relaxed max-w-3xl mb-3">
        Mon objectif est de vous apporter à un prix abordable un niveau de conseil réservé d'habitude aux grands comptes.
      </p>
      <p class="text-lg text-gray-600 leading-relaxed max-w-3xl">
        Vous aurez accès à un vrai expert qui maîtrise les technologies IA les plus récentes tout en s'appuyant sur des années d'expérience en conception des systèmes d'information, en modélisation de processus et en recherche d'information. Je couvre également les aspects non techniques (gouvernance, régulation, droit du numérique) ce qui vous garantit une vision d'ensemble des questions à résoudre pour vos projets.
      </p>
    </div>

    <div class="cards-grid">
      {activitesTop.map(a => (
        <a href={`/activites/${a.slug}/`} class="card">
          <span class="card-icon">{a.icon}</span>
          <h2 class="card-title">{a.titre}</h2>
          {a.soustitre && <p class="card-sub">{a.soustitre}</p>}
          <p class="card-desc">{a.description}</p>
        </a>
      ))}
    </div>

    <div class="cards-grid cards-bottom-row">
      {activitesBottom.map(a => (
        <a href={`/activites/${a.slug}/`} class="card">
          <span class="card-icon">{a.icon}</span>
          <h2 class="card-title">{a.titre}</h2>
          {a.soustitre && <p class="card-sub">{a.soustitre}</p>}
          <p class="card-desc">{a.description}</p>
        </a>
      ))}
    </div>

  </div>
</DefaultLayout>

<style>
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .cards-bottom-row {
    margin-top: 1.5rem;
  }

  .card {
    background: #ffffff;
    border-radius: 20px;
    padding: 2rem 1.8rem;
    text-decoration: none;
    display: block;
    box-shadow:
      6px 6px 18px rgba(180, 140, 60, 0.15),
      -3px -3px 10px rgba(255, 255, 255, 0.9);
    transition: box-shadow 0.2s ease, transform 0.18s ease;
  }

  .card:hover {
    box-shadow:
      10px 10px 28px rgba(180, 140, 60, 0.2),
      -4px -4px 14px rgba(255, 255, 255, 0.95);
    transform: translateY(-3px);
  }

  .card:active {
    box-shadow:
      3px 3px 10px rgba(180, 140, 60, 0.2),
      -1px -1px 6px rgba(255, 255, 255, 0.8);
    transform: translateY(1px);
  }

  .card-icon {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 1rem;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1c1917;
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .card-sub {
    font-size: 0.82rem;
    color: #a16207;
    font-weight: 600;
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .card-desc {
    font-size: 0.88rem;
    color: #6b7280;
    line-height: 1.55;
  }

  @media (max-width: 800px) {
    .cards-grid { grid-template-columns: 1fr; }
  }
</style>
