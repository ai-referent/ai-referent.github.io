---
import DefaultLayout from '../../layouts/DefaultLayout.astro';

const activites = [
  {
    slug: 'amoa',
    icon: '📋',
    titre: 'AMOA',
    soustitre: "Assistance à Maîtrise d'Ouvrage",
    description: 'Accompagnement de projets IA de bout en bout : cadrage, pilotage, coordination entre équipes métier et techniques.',
  },
  {
    slug: 'conferences',
    icon: '🎤',
    titre: 'Conférences / Sessions de décryptage / Sensibilisation',
    soustitre: '',
    description: "Interventions en entreprise ou en formation pour démystifier l'IA, ses enjeux et ses usages concrets.",
  },
  {
    slug: 'docteur-ia',
    icon: '🩺',
    titre: 'Consultations « Docteur IA »',
    soustitre: '',
    description: 'Sessions de diagnostic personnalisé pour identifier les opportunités IA adaptées à votre contexte.',
  },
  {
    slug: 'recrutement-it',
    icon: '🔍',
    titre: 'Conseil en recrutement IT',
    soustitre: '',
    description: "Aide à la définition des profils, à l'évaluation technique et au choix des candidats pour les postes liés à l'IA.",
  },
];
---

<DefaultLayout title="Activités">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-10">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">🎯 Activités</h1>
      <p class="text-xl text-gray-600 leading-relaxed max-w-3xl">
        <!-- TO DO : texte de présentation générale -->
        Lorem ipsum — présentation générale des activités à rédiger.
      </p>
    </div>

    <div class="cards-grid">
      {activites.map(a => (
        <a href={`/activites/${a.slug}/`} class="card">
          <span class="card-icon">{a.icon}</span>
          <h2 class="card-title">{a.titre}</h2>
          {a.soustitre && <p class="card-sub">{a.soustitre}</p>}
          <p class="card-desc">{a.description}</p>
        </a>
      ))}
    </div>

  </div>
</DefaultLayout>

<style>
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .card {
    background: #ffffff;
    border-radius: 20px;
    padding: 2rem 1.8rem;
    text-decoration: none;
    display: block;
    box-shadow:
      6px 6px 18px rgba(180, 140, 60, 0.15),
      -3px -3px 10px rgba(255, 255, 255, 0.9);
    transition: box-shadow 0.2s ease, transform 0.18s ease;
  }

  .card:hover {
    box-shadow:
      10px 10px 28px rgba(180, 140, 60, 0.2),
      -4px -4px 14px rgba(255, 255, 255, 0.95);
    transform: translateY(-3px);
  }

  .card:active {
    box-shadow:
      3px 3px 10px rgba(180, 140, 60, 0.2),
      -1px -1px 6px rgba(255, 255, 255, 0.8);
    transform: translateY(1px);
  }

  .card-icon {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 1rem;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1c1917;
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .card-sub {
    font-size: 0.82rem;
    color: #a16207;
    font-weight: 600;
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .card-desc {
    font-size: 0.88rem;
    color: #6b7280;
    line-height: 1.55;
  }

  @media (max-width: 600px) {
    .cards-grid { grid-template-columns: 1fr; }
  }
</style>
