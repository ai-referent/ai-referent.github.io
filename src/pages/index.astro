---
import { getCollection } from 'astro:content';
import DefaultLayout from '../layouts/DefaultLayout.astro';
import { readFileSync } from 'fs';
import { upcomingConferences } from '../data/upcoming-conferences';

const svgDiagram = readFileSync('./secure-agentic-diagram.svg', 'utf-8');

// Get all posts and sort by date (newest first)
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Get the 3 most recent posts for the homepage carousel
const recentPosts = sortedPosts.slice(0, 3);

const conferenceDateFormatter = new Intl.DateTimeFormat('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<DefaultLayout title="Accueil">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">

    <!-- ===== HERO SECTION ===== -->
    <section class="mb-16 bg-gradient-to-r from-blue-50 via-indigo-50 to-amber-50 rounded-xl p-8 border border-amber-100">
      <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-6">

        <!-- Photo (left) -->
        <div class="flex justify-center">
          <div class="w-36 h-36 md:w-44 md:h-44 rounded-full border-2 border-stone-300 overflow-hidden">
            <img src="/IMG.jpg" alt="Photo" class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Title text (center) -->
        <div class="text-center md:text-left">
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">AI Referent</h1>
          <p class="text-sm md:text-base text-gray-600 leading-relaxed">Expertise de haut niveau en intelligence artificielle, systèmes agentiques et modélisation des données</p>
        </div>

        <!-- Diagram (right) -->
        <div class="flex justify-center">
          <div class="w-full max-w-xs" set:html={svgDiagram} />
        </div>

      </div>
    </section>

    <!-- ===== PROFIL ===== -->
    <section id="profil" class="mb-16">
      <div class="bg-white rounded-lg shadow-md p-8 border border-gray-200">
        <p class="text-lg text-gray-700 leading-relaxed">
          Chercheur reconnu en IA, auteur de nombreuses publications, mon parcours professionnel m'a également donné l'occasion d'acquérir une grande expérience dans le domaine de la conception des systèmes d'information ainsi que de leur gouvernance. La combinaison de ces compétences fait de moi un interlocuteur pertinent pour vous apporter un accompagnement de haut niveau et sans angles morts.
        </p>
      </div>
    </section>

    <!-- ===== ARTICLES RÉCENTS + CONFÉRENCES À VENIR ===== -->
    <section class="mb-16 grid grid-cols-1 md:grid-cols-2 gap-8 items-start">

      <!-- Colonne gauche : articles récents (carrousel statique) -->
      <div id="blog">
        <h2 class="text-3xl font-bold mb-6 text-gray-900">📝 Articles récents</h2>
        <div class="flex gap-4 overflow-x-auto pb-2 -mx-1 px-1 snap-x">
          {recentPosts.map((post) => (
            <article class="snap-start shrink-0 w-72 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow p-6 border border-gray-200">
              <h3 class="text-lg font-bold mb-3">
                <a href={`/blog/${post.slug}`} class="text-blue-600 hover:text-blue-700 transition">
                  {post.data.title}
                </a>
              </h3>
              <div class="text-sm text-gray-600 mb-3">
                📅 {new Intl.DateTimeFormat('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.date)}
              </div>
              {post.data.excerpt && <p class="text-gray-700 text-sm line-clamp-4">{post.data.excerpt}</p>}
            </article>
          ))}
        </div>
        <div class="mt-6 text-center">
          <a href="/blog/" class="inline-block bg-blue-600 text-white font-semibold px-8 py-3 rounded-lg hover:bg-blue-700 transition">
            Voir plus ↠
          </a>
        </div>
      </div>

      <!-- Colonne droite : conférences à venir -->
      <div id="conferences-a-venir">
        <h2 class="text-3xl font-bold mb-6 text-gray-900">🎤 Conférences à venir</h2>
        {upcomingConferences.length > 0 ? (
          <div class="space-y-4">
            {upcomingConferences.map((conf) => (
              <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200">
                <h3 class="text-lg font-bold text-gray-900 mb-2">{conf.title}</h3>
                <div class="text-sm text-gray-600 mb-3">📅 {conferenceDateFormatter.format(conf.date)}</div>
                <p class="text-gray-700 mb-4">{conf.summary}</p>
                <a href={conf.bookingUrl} class="inline-block bg-blue-600 text-white font-semibold px-6 py-2.5 rounded-lg hover:bg-blue-700 transition">
                  Réserver ma place
                </a>
              </div>
            ))}
          </div>
        ) : (
          <div class="bg-white rounded-lg shadow-md p-8 border border-gray-200 text-gray-700">
            Aucune conférence n'est programmée pour le moment. Consultez la page <a href="/activites/conferences/" class="text-blue-600 hover:text-blue-700 font-medium transition">Conférences</a> pour proposer un sujet.
          </div>
        )}
      </div>

    </section>

    <!-- ===== CONTACT ===== -->
    <section id="contact" class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-gray-900">✉️ Contact</h2>
      <div class="bg-white rounded-lg shadow-md p-8 border border-gray-200">
        <a href="mailto:ai.referent@gmail.com" class="inline-flex items-center text-lg font-semibold text-blue-600 hover:text-blue-700 transition">
          📧 ai.referent@gmail.com
        </a>
      </div>
    </section>

  </div>
</DefaultLayout>
