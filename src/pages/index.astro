---
import { getCollection } from 'astro:content';
import DefaultLayout from '../layouts/DefaultLayout.astro';
import PostCard from '../components/PostCard.astro';
import { readFileSync } from 'fs';

const svgDiagram = readFileSync('./secure-agentic-diagram.svg', 'utf-8');

// Get all posts and sort by date (newest first)
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Get the 5 most recent posts
const recentPosts = sortedPosts.slice(0, 5);
---

<DefaultLayout title="Accueil">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">

    <!-- ===== HERO SECTION ===== -->
    <section class="mb-16 bg-gradient-to-r from-blue-50 via-indigo-50 to-amber-50 rounded-xl p-8 border border-amber-100">
      <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-6">

        <!-- Photo (left) -->
        <div class="flex justify-center">
          <div class="w-36 h-36 md:w-44 md:h-44 rounded-full border-2 border-stone-300 overflow-hidden">
            <img src="/IMG.jpg" alt="Photo" class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Title text (center) -->
        <div class="text-center md:text-left">
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">AI Référent</h1>
          <p class="text-sm md:text-base text-gray-600 leading-relaxed">Expertise en intelligence artificielle et gouvernance des systèmes IA</p>
        </div>

        <!-- Diagram (right) -->
        <div class="flex justify-center">
          <div class="w-full max-w-xs" set:html={svgDiagram} />
        </div>

      </div>
    </section>

    <!-- ===== PROFIL ===== -->
    <section id="profil" class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-gray-900">👤 Profil</h2>
      <div class="bg-white rounded-lg shadow-md p-8 border border-gray-200">
        <p class="text-lg text-gray-700 mb-4 leading-relaxed">
          Chercheur reconnu en IA, auteur de nombreuses publications et expert des modèles les plus récents, mon parcours professionnel m'a également donné l'occasion de travailler dans le domaine de la gouvernance et de la sécurité des systèmes d'IA. J'ai ainsi exercé pendant plusieurs années au sein du Pôle d'expertise de la régulation numérique (PEReN), complétant mon profil technique par une dimension juridique et réglementaire.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          La combinaison de ces deux compétences fait de moi un interlocuteur pertinent pour accompagner la prise des bonnes décisions dans le développement de l'IA.
        </p>
      </div>
    </section>

    <!-- ===== PROJETS ===== -->
    <section id="projets" class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-gray-900">🛠️ Projets</h2>
      <div class="bg-white rounded-lg shadow-md p-8 border border-gray-200">
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">
          En plus de nombreux prototypes universitaires, j'ai joué un rôle central dans le développement de deux packages d'envergure : un outil d'évaluation automatisée de modèles multimodaux (PEReN) et <strong>Coclust</strong>, une librairie de co-clustering de textes publiée dans le <em>Journal of Statistical Software</em>.
        </p>
        <a href="/projects/" class="inline-block bg-blue-600 text-white font-semibold px-8 py-3 rounded-lg hover:bg-blue-700 transition">
          Voir les projets ↠
        </a>
      </div>
    </section>

    <!-- ===== CONTACT ===== -->
    <section id="contact" class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-gray-900">✉️ Contact</h2>
      <div class="bg-white rounded-lg shadow-md p-8 border border-gray-200">
        <a href="mailto:xxx.yyy@gmail.com" class="inline-flex items-center text-lg font-semibold text-blue-600 hover:text-blue-700 transition">
          📧 xxx.yyy@gmail.com
        </a>
      </div>
    </section>

    <!-- ===== BLOG (articles récents) ===== -->
    <section id="blog" class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-gray-900">📝 Articles récents</h2>
      <div class="grid gap-6">
        {recentPosts.map((post) => (
          <PostCard
            title={post.data.title}
            url={`/blog/${post.slug}`}
            date={post.data.date}
            tags={post.data.tags}
            reading_time={post.data.reading_time}
            excerpt={post.data.excerpt}
          />
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/blog/" class="inline-block bg-blue-600 text-white font-semibold px-8 py-3 rounded-lg hover:bg-blue-700 transition">
          Voir tous les articles ↠
        </a>
      </div>
    </section>

  </div>
</DefaultLayout>
