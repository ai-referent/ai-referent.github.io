---
import { getCollection } from 'astro:content';
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import BlogFiltering from '../../components/BlogFiltering.astro';

// Get all posts and sort by date (newest first)
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<DefaultLayout title="Blog">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">📚 Blog</h1>
      <p class="text-xl text-gray-600">Articles sur l'IA, la gouvernance et la sécurité des systèmes</p>
    </div>
    <BlogFiltering posts={sortedPosts} />
  </div>
</DefaultLayout>
